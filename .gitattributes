*.avi filter=lfs diff=lfs merge=lfs -text

# Font files
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text

# Unity scenes & prefabs (binary handled by LFS)
*.unity filter=lfs diff=lfs merge=lfs -text
*.prefab filter=lfs diff=lfs merge=lfs -text
*.mat filter=lfs diff=lfs merge=lfs -text

*.psb filter=lfs diff=lfs merge=lfs -text
*.ase filter=lfs diff=lfs merge=lfs -text
*.tiledmap filter=lfs diff=lfs merge=lfs -text

# Keep text-based Unity files as text
*.meta text
*.asmdef text
*.cs text
*.shader text
*.txt text

# ProjectSettings - keep in Git for consistent team environment
ProjectSettings/*.asset text
ProjectSettings/SceneTemplateSettings.json text